# Copy this file to ".env" and fill in real values from:
# Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and configuration
#
# .env is gitignored on purpose - never commit real keys.
# Every teammate keeps their own local .env (same values, or their own
# dev Firebase project if you're using separate dev/prod projects).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
